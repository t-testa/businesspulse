# For documentation only. Environment variables are not automatically loaded.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-this-with-a-secure-random-string-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Use PostgreSQL when deploying. Locally, omitting DATABASE_URL uses SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/businesspulse
# Local Docker only: postgresql://businesspulse:local-synthetic-only@127.0.0.1:55432/businesspulse
# Staging: DJANGO_DEBUG=0, a fresh strong secret, explicit hosts, and PostgreSQL are mandatory.
# Render internal database TLS is optional; set DB_SSL_REQUIRE=1 when TLS is required.
# External Render database connections require TLS; never reuse the local Docker password.
